APP_TIMEZONE=Asia/Tokyo
FRONTEND_ORIGIN=http://localhost:3000
# 以下の秘密値は自分で設定してください。CRON_SECRET は scheduler と揃えます。
ADMIN_PASSWORD=
AUTH_SECRET=
CRON_SECRET=
# 実際に Web Push を送る場合は生成した鍵と連絡先を設定してください。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SQLITE_PATH=/data/otsuge.sqlite3
